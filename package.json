{
  "name": "my-blog",
  "private": true,
  "scripts": {
    "preview": "zenn preview",
    "preview:qiita": "qiita preview --root Qiita",
    "list:articles": "zenn list:articles",
    "list:books": "zenn list:books",
    "new:qiita": "qiita new --root Qiita",
    "pull:qiita": "qiita pull --root Qiita",
    "publish:qiita": "bash scripts/publish-qiita.sh",
    "publish:qiita:all": "qiita publish --all --root Qiita",
    "check:qiita": "qiita version",
    "check:note-ref": "node scripts/check-note-reference.js",
    "check:note-images": "node scripts/check-note-images.js",
    "check:note-tables": "node scripts/check-note-tables.js",
    "check:qiita-publish-hygiene": "node scripts/check-qiita-publish-hygiene.js",
    "check:doc-freshness": "node scripts/check-doc-freshness.js",
    "check:zenn-pace": "node scripts/check-zenn-publish-pace.js",
    "test:zenn-pace": "node scripts/check-zenn-publish-pace.js --self-test",
    "gh:ensure": "bash scripts/check-gh-account.sh --fix",
    "check:zenn-title": "node scripts/check-zenn-title-length.js",
    "check:fm-title": "node scripts/check-frontmatter-title-yaml.js",
    "check:faq-coverage": "node scripts/check-article-faq-coverage.js",
    "check:qiita-drift": "node scripts/check-qiita-drift.js",
    "check:qiita-remote-cache": "node scripts/check-qiita-remote-cache.js",
    "check:internal-links": "node scripts/check-internal-links.js",
    "check:pr-staleness": "bash scripts/check-pr-staleness.sh",
    "test:pr-staleness": "bash scripts/test-check-pr-staleness.sh",
    "cleanup:pr": "bash scripts/cleanup-pr-worktree.sh",
    "test:cleanup-pr": "bash scripts/test-cleanup-pr-worktree.sh",
    "check:publish-readiness": "node scripts/check-publish-readiness.js",
    "test:publish-readiness": "node scripts/check-publish-readiness.js --self-test",
    "check:article-humanizer-contract": "node scripts/check-article-humanizer.js",
    "check:article-language-density": "node scripts/check-article-language-density.js",
    "check:article-humanizer": "npm run check:article-humanizer-contract && npm run check:article-language-density",
    "test:article-humanizer-contract": "node scripts/check-article-humanizer.js --self-test",
    "test:article-language-density": "node scripts/check-article-language-density.js --self-test",
    "test:article-humanizer": "npm run test:article-humanizer-contract && npm run test:article-language-density",
    "check:note-finalize": "node scripts/check-note-finalize.js",
    "test:note-finalize": "node scripts/check-note-finalize.js --self-test",
    "check:note-thesis-snapshot": "node scripts/check-note-thesis-review-loop.js && node scripts/check-note-thesis-snapshot.js --self-test",
    "test:note-thesis-snapshot": "node scripts/check-note-thesis-review-loop.js --self-test && node scripts/check-note-thesis-snapshot.js --self-test",
    "check:zenn-image-format": "node scripts/check-zenn-image-format.js",
    "test:zenn-image-format": "node scripts/check-zenn-image-format.js --self-test",
    "check:note-setext": "node scripts/check-note-setext.js",
    "test:note-setext": "node scripts/check-note-setext.js --self-test",
    "check:queue-drift": "node scripts/check-queue-drift.js",
    "test:queue-drift": "node scripts/check-queue-drift.js --self-test",
    "clean:note-build": "node scripts/clean-note-build.js",
    "clean:note-build:dry": "node scripts/clean-note-build.js --dry-run",
    "test:clean-note-build": "node scripts/clean-note-build.js --self-test",
    "check": "bash -c 'set -uo pipefail; checks=\"list:articles list:books check:qiita check:note-ref check:note-images check:note-tables check:qiita-publish-hygiene check:doc-freshness check:zenn-title check:fm-title check:faq-coverage check:internal-links check:zenn-pace check:learnings-index check:article-humanizer-contract check:note-finalize check:note-thesis-snapshot check:zenn-image-format check:note-setext check:queue-drift\"; failed=\"\"; for c in $checks; do printf \"\\n=== %s ===\\n\" \"$c\"; npm run --silent \"$c\" || failed=\"$failed $c\"; done; if [ -n \"$failed\" ]; then printf \"\\n[check] FAILED:%s\\n\" \"$failed\" >&2; exit 1; fi; printf \"\\n[check] all %s checks passed\\n\" \"$(printf %s \"$checks\" | wc -w | tr -d \" \")\"'",
    "check:learnings-index": "node scripts/check-learnings-index.js",
    "test:learnings-index": "node scripts/check-learnings-index.js --self-test",
    "suggest:theme": "node scripts/suggest-next-theme.js",
    "test:suggest-theme": "node scripts/suggest-next-theme.js --self-test"
  },
  "dependencies": {
    "zenn-cli": "^0.5.3"
  },
  "devDependencies": {
    "@qiita/qiita-cli": "^1.10.0"
  }
}
